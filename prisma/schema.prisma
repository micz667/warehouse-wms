// Prisma schema — warehouse WMS.
// Stock quantity must never be a writable ad-hoc column; balances come from movements (later).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  magazynier
  architekt
  admin
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(magazynier)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
