// Prisma schema — warehouse WMS.
// Stock quantity must never be a writable ad-hoc column; balances come from movements (later).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  magazynier
  architekt
  admin
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(magazynier)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Durable catalog SKU. Barcode is Code128-compatible (alphanumeric).
/// Stock quantity is never stored here — balances come from movements (later).
model CatalogItem {
  id        String   @id @default(cuid())
  sku       String   @unique
  name      String
  category  String
  unit      String
  barcode   String   @unique
  photoPath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([category])
}

/// Flat hall location. `code` is the scannable Code128 value (unique).
model Location {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([label])
}
