// Prisma schema — warehouse WMS.
// Stock quantity must never be a writable ad-hoc column; balances come from movements.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  magazynier
  architekt
  admin
}

enum StocktakeStatus {
  draft
  counting
  approved
}

/// Explicit movement kinds. Stock is only the sum of these rows (signed qty).
/// `receipt` / `issue` / `transfer` are seeded for F006 proof; F007 adds scan UI.
enum MovementType {
  opening
  receipt
  issue
  transfer
}

/// Architect shopping list lifecycle. Fulfillment is a warehouse checklist only.
enum ShoppingListStatus {
  draft
  submitted
  done
}

/// Cafe issue document. Prepare (F013a) leaves stock unchanged; signature
/// (F013b) posts issue movements. `prepared` = in-transit; `received` = signed.
enum CafeIssueStatus {
  prepared
  received
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  passwordHash         String
  name                 String?
  role                 Role               @default(magazynier)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  stocktakeSessions    StocktakeSession[]
  movements            Movement[]
  shoppingLists        ShoppingList[]
  shoppingListChecks   ShoppingListLine[] @relation("ShoppingListLineCheckedBy")
  cafeIssues           CafeIssue[]        @relation("CafeIssueCreatedBy")
  cafeIssuesSigned     CafeIssue[]        @relation("CafeIssueSignedBy")
}

/// Durable catalog SKU. Barcode is Code128-compatible (alphanumeric).
/// Stock quantity is never stored here — balances come from movements.
model CatalogItem {
  id               String             @id @default(cuid())
  sku              String             @unique
  name             String
  category         String
  unit             String
  barcode          String             @unique
  /// Free-text note from hall inline create (F011); optional on admin CRUD.
  description      String?
  photoPath        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  stocktakeLines    StocktakeLine[]
  movements         Movement[]
  shoppingListLines ShoppingListLine[]
  cafeIssueLines    CafeIssueLine[]

  @@index([name])
  @@index([category])
}

/// Flat hall location. `code` is the scannable Code128 value (unique).
model Location {
  id                  String          @id @default(cuid())
  code                String          @unique
  label               String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  stocktakeLines      StocktakeLine[]
  movements           Movement[]
  cafeIssuesAsCafe    CafeIssue[]     @relation("CafeIssueCafeLocation")
  cafeIssueLineSources CafeIssueLine[] @relation("CafeIssueLineSource")

  @@index([label])
}

/// Physical stocktake session (`spis z natury`). Opening stock is posted only on approve.
model StocktakeSession {
  id          String          @id @default(cuid())
  status      StocktakeStatus @default(draft)
  note        String?
  createdById String?
  approvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  lines       StocktakeLine[]
  movements   Movement[]
  createdBy   User?           @relation(fields: [createdById], references: [id])

  @@index([status])
}

model StocktakeLine {
  id            String           @id @default(cuid())
  sessionId     String
  catalogItemId String
  locationId    String
  countedQty    Decimal          @db.Decimal(18, 3)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  session       StocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem      @relation(fields: [catalogItemId], references: [id])
  location      Location         @relation(fields: [locationId], references: [id])
  movement      Movement?

  @@unique([sessionId, catalogItemId, locationId])
  @@index([sessionId])
}

/// Append-only stock movement. Qty is a signed delta; balances = SUM(qty).
/// Opening rows are written by stocktake approval; daily kinds by F007 later.
model Movement {
  id                 String            @id @default(cuid())
  type               MovementType
  catalogItemId      String
  locationId         String
  qty                Decimal           @db.Decimal(18, 3)
  stocktakeSessionId String?
  stocktakeLineId    String?           @unique
  createdById        String?
  createdAt          DateTime          @default(now())
  catalogItem        CatalogItem       @relation(fields: [catalogItemId], references: [id])
  location           Location          @relation(fields: [locationId], references: [id])
  stocktakeSession   StocktakeSession? @relation(fields: [stocktakeSessionId], references: [id])
  stocktakeLine      StocktakeLine?    @relation(fields: [stocktakeLineId], references: [id])
  createdBy          User?             @relation(fields: [createdById], references: [id])

  @@index([catalogItemId, locationId])
  @@index([stocktakeSessionId])
}

/// Architect shopping list. Lines are catalog picks; warehouse checks them off.
model ShoppingList {
  id          String             @id @default(cuid())
  status      ShoppingListStatus @default(draft)
  title       String?
  note        String?
  createdById String?
  submittedAt DateTime?
  doneAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  lines       ShoppingListLine[]
  createdBy   User?              @relation(fields: [createdById], references: [id])

  @@index([status])
  @@index([createdAt])
}

model ShoppingListLine {
  id            String       @id @default(cuid())
  listId        String
  catalogItemId String
  qty           Decimal      @db.Decimal(18, 3)
  note          String?
  checkedAt     DateTime?
  checkedById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  list          ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem  @relation(fields: [catalogItemId], references: [id])
  checkedBy     User?        @relation("ShoppingListLineCheckedBy", fields: [checkedById], references: [id])

  @@unique([listId, catalogItemId])
  @@index([listId])
}

/// Hall-prepared cafe shipment. Stock leaves only after signature (F013b).
model CafeIssue {
  id             String          @id @default(cuid())
  status         CafeIssueStatus @default(prepared)
  cafeLocationId String
  note           String?
  createdById    String?
  preparedAt     DateTime        @default(now())
  /// Finger signature PNG data URL; set only on successful sign (F013b).
  signatureData  String?
  signedAt       DateTime?
  signedById     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lines          CafeIssueLine[]
  cafeLocation   Location        @relation("CafeIssueCafeLocation", fields: [cafeLocationId], references: [id])
  createdBy      User?           @relation("CafeIssueCreatedBy", fields: [createdById], references: [id])
  signedBy       User?           @relation("CafeIssueSignedBy", fields: [signedById], references: [id])

  @@index([status])
  @@index([preparedAt])
  @@index([cafeLocationId])
  @@index([signedAt])
}

model CafeIssueLine {
  id               String     @id @default(cuid())
  cafeIssueId      String
  catalogItemId    String
  sourceLocationId String
  qty              Decimal    @db.Decimal(18, 3)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  cafeIssue        CafeIssue  @relation(fields: [cafeIssueId], references: [id], onDelete: Cascade)
  catalogItem      CatalogItem @relation(fields: [catalogItemId], references: [id])
  sourceLocation   Location   @relation("CafeIssueLineSource", fields: [sourceLocationId], references: [id])

  @@unique([cafeIssueId, catalogItemId, sourceLocationId])
  @@index([cafeIssueId])
}
