# Environment

DATABASE_URL="postgresql://warehouse:warehouse@localhost:5432/warehouse?schema=public"

# Auth.js — generate a long random string for local use (e.g. openssl rand -base64 33)
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# Seeded local admin (placeholders only — change before any shared/deployed use)
SEED_ADMIN_EMAIL="admin@local"
SEED_ADMIN_PASSWORD="change-me"
